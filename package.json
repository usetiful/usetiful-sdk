{
  "name": "usetiful-sdk",
  "version": "0.3.0",
  "description": "A lightweight TypeScript/JavaScript SDK for integrating Usetiful user onboarding and product tours into your web applications.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "usetiful",
    "onboarding",
    "product-tours",
    "user-guides",
    "react",
    "typescript",
    "spa",
    "sdk"
  ],
  "author": {
    "name": "Usetiful",
    "url": "https://www.usetiful.com"
  },
  "homepage": "https://github.com/usetiful/usetiful-sdk#readme",
  "bugs": {
    "url": "https://github.com/usetiful/usetiful-sdk/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "NODE_ENV=production ts-node build.ts",
    "build:dev": "NODE_ENV=development ts-node build.ts",
    "build:local": "NODE_ENV=local ts-node build.ts",
    "build:all": "npm run build && npm run build:dev && npm run build:local",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,md}\"",
    "lint": "npm run typecheck && npm run format:check",
    "validate": "npm run lint && npm run test:coverage && npm run build:all",
    "release": "node scripts/release.js",
    "prepublishOnly": "npm run validate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetiful/usetiful-sdk.git"
  },
  "dependencies": {
    "tslib": "^2.6.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "esbuild": "^0.23.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
